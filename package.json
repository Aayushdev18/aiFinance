{
  "name": "ai-finance-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Intelligent backend system for personal finance management featuring deterministic financial analytics, multi-channel ingestion, proactive background monitoring, and a secure multi-tenant AI reasoning agent.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "node --test",
    "eval": "node --experimental-strip-types src/eval/evaluationRunner.ts"
  },
  "keywords": [
    "ai-finance",
    "llm-agent",
    "tool-calling",
    "personal-finance",
    "nodejs",
    "express",
    "postgresql",
    "deterministic-analytics",
    "anomaly-detection"
  ],
  "author": "Aayushdev18",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
