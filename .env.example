PORT=5050
NODE_ENV=development

# Database Configuration (PostgreSQL with Row Level Security)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_finance
PG_MAX_POOL=20
PG_IDLE_TIMEOUT_MS=30000

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# LLM Agent Provider (Gemini / OpenAI / Anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-pro

# Proactive Monitoring Configuration
ANOMALY_SENSITIVITY_SIGMA=2.5
BUDGET_PACING_ALERT_THRESHOLD=1.05
ENABLE_BACKGROUND_CRON=true
